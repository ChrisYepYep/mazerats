# Copy this file to .env and fill in the values. .env is git-ignored and
# must never be committed -- these are live credentials for the real site.
#
# Ask whoever runs the site for these; there is no way to derive them, and
# the dev server, the admin page and the furni scans all need them.

# The site's MongoDB Atlas connection string. Everything the archive stores
# lives here: mazes, events, furni, admins, contact messages.
MONGODB_URI=

# Used once, to create the first admin account. Real admin logins are
# bcrypt-hashed rows in the "admins" collection after that.
ADMIN_PASSWORD=

# Signs the admin session JWTs. Any long random string; changing it logs
# every admin out.
SESSION_SECRET=

# Netlify Blobs, where the furni sprite library is cached. The furni scan
# fills its own local copy from here on first run (tools/.cache/sprites),
# so without these the first scan has to pull ~3,400 sprites from
# FurniIndex instead -- slow, and impolite to them.
NETLIFY_BLOBS_SITE_ID=
NETLIFY_BLOBS_TOKEN=

# Optional. Where room images are fetched from during a scan. Defaults to
# https://mazerats.net, which is what you want unless you are testing
# against a deploy preview.
# SCAN_SITE_URL=

# Optional. Sent as a bearer token when the furni catalogue is fetched from
# FurniIndex (netlify/functions/furni-catalogue.js). Without it the request
# goes out unauthenticated, which works but is rate limited harder.
# FURNIINDEX_API_KEY=

# ---------------------------------------------------------------------------
# Contact form notifications (netlify/functions/contact.js)
#
# A message sent through the contact form is ALWAYS written to the database
# first, and the email is a best-effort extra on top -- so without these the
# form still works and nothing is lost, it just goes unnoticed until somebody
# opens the admin page. That is why they are optional rather than required,
# and why a missing key logs a warning instead of failing the submission.
#
# The destination address lives here rather than in the repo so it stays
# server-side and is never shipped to the client.
#
# RESEND_API_KEY is from https://resend.com. CONTACT_NOTIFY_EMAIL is where
# the notification lands -- both must be set for any email to go out.
# RESEND_API_KEY=
# CONTACT_NOTIFY_EMAIL=

# Optional. The From: address on that notification. Defaults to Resend's own
# onboarding sender, which works without verifying a domain but is obviously
# not your address.
# CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Discord sign-in (netlify/functions/discord-auth.js)
#
# Visitors sign in with Discord to appear on the daily game's leaderboards.
# Everything on the site works signed out; without these two set, the sign-in
# button simply reports that it is not configured on this deploy.
#
# Create an application at https://discord.com/developers/applications, then
# under OAuth2 copy the Client ID and generate a Client Secret. In that same
# OAuth2 screen add a redirect URI for EVERY origin the site runs on --
# Discord matches these exactly, and a missing one is the "invalid redirect
# uri" error:
#
#   https://mazerats.net/auth/discord/callback
#   http://localhost:8888/auth/discord/callback
#
# The only scope asked for is "identify" -- an id, a display name and an
# avatar. No email, no server list.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional. Overrides the origin used to build that redirect URI. Only needed
# if the automatic answer is wrong -- it uses Netlify's own URL in production
# and the incoming request's host under `netlify dev`, which is right for
# both. Set it when testing against a deploy preview whose URL must match
# what is registered with Discord.
# DISCORD_REDIRECT_ORIGIN=
